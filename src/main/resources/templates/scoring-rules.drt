template header
ruleName
moveType
goalType
moveTargetBinding
goalTargetCondition
goalTargetArgument
points
reason

package rules

import com.splendor.assistant.model.facts.explanation.DecisionFact;
import com.splendor.assistant.model.facts.explanation.DecisionLevel;
import com.splendor.assistant.model.GoalType;
import com.splendor.assistant.model.Move;
import com.splendor.assistant.model.facts.scoring.MoveScoreFact;
import com.splendor.assistant.model.MoveType;
import com.splendor.assistant.model.facts.strategy.StrategicGoalFact;

template "strategic-goal-scoring-rules"

rule "@{ruleName}"
when
    $move: Move(type == MoveType.@{moveType}@{moveTargetBinding})
    StrategicGoalFact(type == GoalType.@{goalType}@{goalTargetCondition})
then
    insertLogical(new MoveScoreFact($move, @{points}, "@{reason}", DecisionFact.goal(GoalType.@{goalType}@{goalTargetArgument})));
    insertLogical(DecisionFact.of(DecisionFact.move($move), DecisionFact.goal(GoalType.@{goalType}@{goalTargetArgument}), DecisionLevel.MOVE_SCORE, "move score derived from strategic goal"));
end

end template
